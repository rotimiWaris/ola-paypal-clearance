# PayPal sandbox

# Create a REST app at https://developer.paypal.com/dashboard/applications/sandbox
# and paste the sandbox client id and secret. No live money moves.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional. Leave blank to use the on-desk policy agent.
# A free key from https://console.groq.com or Google AI Studio is enough.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
